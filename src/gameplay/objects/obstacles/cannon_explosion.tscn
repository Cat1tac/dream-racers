[sub_resource type="Shader" id="Shader_ylunt"]
code = "shader_type spatial;

render_mode blend_add, unshaded, cull_disabled;

uniform sampler2D noise_tex : repeat_enable;
uniform sampler2D color_grad;
uniform sampler2D disappear_gradient;
uniform vec2 scale = vec2(1,1); 
uniform float speed = 1;
uniform float fill : hint_range(0.0, 1.0, 0.01);

uniform sampler2D depth_tex : hint_depth_texture;
uniform float proximity_fade : hint_range(0.01, 100, 0.01);

void vertex() {
	// Called for every vertex the material is visible on.
}

void fragment() {
	vec4 noise = texture(noise_tex, UV * scale + vec2(TIME * speed, 0));
	vec4 noise2 = texture(noise_tex, UV + vec2(0, sin(TIME * speed)));
	vec4 color = texture(color_grad, UV);
	vec4 disappear = texture(disappear_gradient, UV);
	
	float fade;
	// ProximityFade:30
	{
		float __depth_tex = texture(depth_tex, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		fade = clamp(1.0 - smoothstep(__depth_world_pos.z + proximity_fade, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}
	
	ALBEDO = color.rgb;
	ALPHA = smoothstep(disappear.r, 1, fill) *  clamp(noise.r + noise2.r, 0, 1) * fade;
	EMISSION = color.rgb * 10.;
}

//void light() {
//	// Called for every pixel for every light affecting the material.
//	// Uncomment to replace the default light processing function with this one.
//}
"


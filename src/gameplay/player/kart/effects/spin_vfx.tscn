[sub_resource type="Shader" id="Shader_1b2e5"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.7.1.stable.mono's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_toon, specular_schlick_ggx, unshaded;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform ivec2 albedo_texture_size;
uniform float point_size : hint_range(0.1, 128.0, 0.1);

uniform sampler2D mask;
uniform sampler2D vertical_mask;
uniform vec3 emission_color : source_color;
uniform float y_offest;
uniform float rotation_speed = 2.;

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;
}

void fragment() {
	vec2 base_uv = UV;
	
	vec4 mask_tex = texture(mask, base_uv);
	vec4 v_mask_tex_1 = texture(vertical_mask, base_uv + vec2(0, -0.3 + y_offest + (rotation_speed * TIME)));
	vec4 v_mask_tex_2 = texture(vertical_mask, base_uv + vec2(0, 0.3 + y_offest + (rotation_speed * TIME)));
	vec4 albedo_tex = texture(texture_albedo, base_uv + vec2(0, y_offest + (rotation_speed * TIME)));
	
	float masked_tex = mask_tex.r * albedo_tex.r * v_mask_tex_1.r * v_mask_tex_2.r;
	
	ALBEDO = albedo.rgb * albedo_tex.rgb;
	ALPHA = masked_tex;
	EMISSION *= emission_color;
	

}
"

